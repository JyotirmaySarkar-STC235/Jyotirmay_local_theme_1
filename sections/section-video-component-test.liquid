{% comment %} <div class="my-video-wrapper">
  <video class="my-video" src="{{ section.settings.custom_component_video.sources[0].url }}"></video>
</div> {% endcomment %}

<my-video-player
    video-src="{{ section.settings.custom_component_video.sources[0].url }}"
></my-video-player>



{% comment %} <style>
  .my-video-wrapper {
    width: 400px;
    height: 400px;
  }

  .my-video {
    display: block;
    width: 100%;
    height: 100%;
  }
</style> {% endcomment %}

<script>
  class MyVideoComponent extends HTMLElement {
    constructor() {
      super();

      this.attachShadow({ mode: 'open' });

      this.shadowRoot.innerHTML = `
                <div class="my-video-wrapper">
                     <video class="my-video"></video>
                     <button class="video-btn">Play</button>
                </div>
                <style>
                    :host {
                        display: block;
                        width: 400px;
                        height: 400px;
                    }
                    .my-video-wrapper {
                        width: 400px;
                        height: 400px;
                        position: relative;
                    }

                    .my-video {
                        display: block;
                        width: 100%;
                        height: 100%;
                    }
                    .video-btn {
                        position: absolute;
                        left: 50%;
                        top: 50%;
                        transform: -50%, -50%;
                    }
                </style>
            `;
    }

    connectedCallback() {
        // GETTING THE VIDEO  AND BUTOTN
        this.video = this.shadowRoot.querySelector("video")
        this.button = this.shadowRoot.querySelector("button")

        // GETTING THE SRC FOR THE VIDEO PASSED FROM SCHEMA INPUT
        this.videoSrc = this.getAttribute("video-src")

        // SET THE SRC FOR THE VIDEO
        this.video.setAttribute("src", this.videoSrc)

        this.button.addEventListener("click", ()=>{
            if(this.video.paused){
                this.video.play()
                this.button.innerText = "Pause"
            } else {
                this.video.pause()
                this.button.innerText = "Play"
            }
        })

        // ATTACH A PLAY EVENT IN THE VIDEO AND WHEN A VIDEO IS PLAYING DISPATCH A CUSTOM EVENT 
        // ATTACH A EVENT LISTENER IN THE DOCUMENT LEVEL AND FROM THERE PAUSE THE VIDEO

    }
    disconnectedCallback() {}
  }

  customElements.define("my-video-player", MyVideoComponent)
</script>

{% schema %}
{
  "name": "Video component test",
  "settings": [
    {
      "type": "video",
      "id": "custom_component_video",
      "label": "Add your video here"
    }
  ],
  "presets": [
    {
      "name": "Video component test"
    }
  ]
}
{% endschema %}
