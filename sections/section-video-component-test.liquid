<my-video-player
  video-src="{{ section.settings.custom_component_video.sources[0].url }}"
></my-video-player>

<script>
  if (!customElements.get('my-video-player')) {
    class MyVideoComponent extends HTMLElement {
      constructor() {
        super();

        this.attachShadow({ mode: 'open' });

        this.shadowRoot.innerHTML = `
                <div class="my-video-wrapper">
                     <video class="my-video"></video>
                     <button class="video-btn">Play</button>
                </div>
                <style>
                    :host {
                        display: block;
                        width: 400px;
                        height: 400px;
                    }
                    .my-video-wrapper {
                        width: 400px;
                        height: 400px;
                        position: relative;
                    }

                    .my-video {
                        display: block;
                        width: 100%;
                        height: 100%;
                    }
                    .video-btn {
                        position: absolute;
                        left: 50%;
                        top: 50%;
                        transform: -50%, -50%;
                    }
                </style>
            `;
      }

      connectedCallback() {
        // GETTING THE VIDEO  AND BUTOTN
        this.video = this.shadowRoot.querySelector('video');
        this.button = this.shadowRoot.querySelector('button');

        // GETTING THE SRC FOR THE VIDEO PASSED FROM SCHEMA INPUT
        this.videoSrc = this.getAttribute('video-src');

        // SET THE SRC FOR THE VIDEO
        this.video.setAttribute('src', this.videoSrc);

        this.button.addEventListener('click', this.togglePlay.bind(this));

        // ATTACH A PLAY EVENT IN THE VIDEO AND WHEN A VIDEO IS PLAYING DISPATCH A CUSTOM EVENT
        this.video.addEventListener('play', this.videoPlayHandler.bind(this));

        // ATTACH A EVENT LISTENER IN THE DOCUMENT LEVEL AND FROM THERE PAUSE THE VIDEO
        document.addEventListener('video-playing', this.videoPlayinghandler.bind(this));
      }

      disconnectedCallback() {
        // REMOVE EVENT LISTNER FROM THE DOCUMENT LEVEL
        document.removeEventListener('video-playing', this.videoPlayinghandler);
        // REMOVE EVENT LISTENER FROM THE BUTTON
        this.button.removeEventListener('click', this.togglePlay);
        // REMOVE EVENT LISTENER FROM THE VIDEO
        this.video.removeEventListener('play', this.videoPlayHandler);
      }
    
      // `````````````````````````````````````````````````````````` CONSTRUCTION  ``````````````````````````````````````````````````````````
      // 1️⃣ Tell browser which attributes to watch
    //   static get observedAttributes() {
    //     return ['data-state']; // attribute name
    //   }

      // 2️⃣ Called whenever attribute changes
    //   attributeChangedCallback(name, oldValue, newValue) {
    //     if (oldValue === newValue) {
    //         return
    //     }

    //     if (name === "data-state") {
    //         if(newValue === "paused"){
    //             this.video.pause();
    //         }
    //     }
    //   }

    //   `````````````````````````````````````````````````` END CONSTRUCTION ``````````````````````````````````````````````````````````````````````````

      // EVENT HANDLERS
      togglePlay() {
        console.log(`video is in paused state: ${this.video.paused}`);

        if (this.video.paused) {
          this.video.play();
          this.button.innerText = 'Pause';
        //   this.setAttribute("data-state", "playing")
        } else {
          this.video.pause();
          this.button.innerText = 'Play';
        }
      }

      videoPlayHandler() {
        console.log(`Video play handler running....`);
        // PAUSE ALL THE OTHER VIDEOS IN THE DOCUMENT
        let allVideos = document.querySelectorAll('video');
        allVideos.forEach((vid) => {
          vid.pause();
          let btn = vid.parentElement.querySelector('button');
          if (btn) {
            btn.innerText = 'Play';
          }
        });

        const videoPlayingEvent = new CustomEvent('video-playing', {
          bubbles: true,
          composed: true,
          detail: {
            videoElement: this.video,
          },
        });
        this.dispatchEvent(videoPlayingEvent);
      }

      videoPlayinghandler(e) {
        if (e.detail.videoElement !== this.video) {
          this.video.pause();
          this.button.innerText = 'Play';
        }
      }
    }

    customElements.define('my-video-player', MyVideoComponent);
  }
</script>

{% schema %}
{
  "name": "Video component test",
  "settings": [
    {
      "type": "video",
      "id": "custom_component_video",
      "label": "Add your video here"
    }
  ],
  "presets": [
    {
      "name": "Video component test"
    }
  ]
}
{% endschema %}
