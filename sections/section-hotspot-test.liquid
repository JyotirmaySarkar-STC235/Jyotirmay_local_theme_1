<div class="hotspot-section__wrapper">
  {% if section.settings.hotspot_section_image != blank %}
    <div class="hotspot-section__image-container">
      {{ section.settings.hotspot_section_image | image_url: width: 2000 | image_tag }}
    </div>
    {% for block in section.blocks %}
      {% if block.type == 'hotspot' %}
        {% if block.settings.hotspot_product != blank %}
          <button
            class="hotspot-btn"
            style="
              left: {{ block.settings.x_position }}%;
              top: {{ block.settings.y_position }}%;
            "
            {{ block.shopify_attributes }}
            data-product-id="{{block.settings.hotspot_product.id}}"
            data-product-title="{{block.settings.hotspot_product.title}}"
            data-product-price="{{block.settings.hotspot_product.price}}"
            data-product-image="{{block.settings.hotspot_product.featured_image  |  image_url: width: 200}}"
            data-product-url="{{block.settings.hotspot_product.url}}"
            data-x-axis="{{block.settings.x_position}}"
            data-y-axis="{{block.settings.y_position}}"
          >
            +
          </button>
        {% else %}
          <p>Target Product is blank</p>
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}

  <!-- Product Card Modal -->
  <div id="hotspot-modal" aria-hidden="true">
    <div id="hotspot-modal__card" role="dialog" aria-modal="true">
      <button id="hotspot-modal__close" type="button" aria-label="Close modal">×</button>

      <!-- JS will inject product markup here -->
      <div id="hotspot-modal__body"></div>
    </div>
  </div>
</div>

<style>
  .hotspot-section {
    box-sizing: border-box;
  }

  .hotspot-section__wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 0;
    position: relative;
  }

  /* Needed later for hotspots */
  .hotspot-section__image-container {
    position: relative;
    width: 100%;
  }

  /* Let image define the container height */
  .hotspot-section__image-container img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hotspot-btn {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #000;
    color: #fff;
    border: none;
    cursor: pointer;

    /* Center the dot exactly on the point */
    transform: translate(-50%, -50%);
  }

  /* Modal container - positioned relative to image */
  #hotspot-modal {
    position: absolute;
    /* bottom: 50px;
    left: 20px; */
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  #hotspot-modal.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Modal card */
  #hotspot-modal__card {
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    padding: 12px;
    width: 300px;
    height: 153px;
    position: relative;
    overflow: hidden;
  }

  /* Close button */
  #hotspot-modal__close {
    position: absolute;
    top: 5px;
    right: 5px;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    color: #666;
    padding: 2px;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: color 0.2s ease, background 0.2s ease;
    z-index: 10;
  }

  #hotspot-modal__close:hover {
    color: #000;
    background: #fff;
  }

  /* Modal body content - Flex layout */
  #hotspot-modal__body {
    display: flex;
    gap: 12px;
    height: 100%;
  }

  /* Left side - Image */
  #hotspot-modal__body img {
    width: 106px;
    height: 106px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }

  /* Right side - Content wrapper */
  #hotspot-modal__body > div {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  #hotspot-modal__body h2 {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 4px 0;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    padding-right: 20px; /* Space for close button */
  }

  #hotspot-modal__body .price {
    font-size: 13px;
    font-weight: 500;
    color: #333;
    margin-bottom: 8px;
  }

  /* Actions container */
  #hotspot-modal__body .actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #hotspot-modal__body .actions form {
    margin: 0;
  }

  #hotspot-modal__body .actions button[type='submit'] {
    width: 100%;
    padding: 6px 12px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  #hotspot-modal__body .actions button[type='submit']:hover {
    background: #333;
  }

  #hotspot-modal__body .actions a {
    display: block;
    text-align: center;
    padding: 5px 12px;
    color: #000;
    text-decoration: none;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 11px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  #hotspot-modal__body .actions a:hover {
    border-color: #000;
    background: #f9f9f9;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    #hotspot-modal {
      bottom: 10px;
      left: 10px;
    }
  }
</style>

<script>
  const hotspotButtons = document.querySelectorAll('.hotspot-btn');
  const modal = document.querySelector('#hotspot-modal');
  const modalCard = document.querySelector('#hotspot-modal__card');
  const modalBody = document.querySelector('#hotspot-modal__body');
  const modalCloseBtn = document.querySelector('#hotspot-modal__close');

  hotspotButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const { productId, productTitle, productPrice, productImage, productUrl, xAxis, yAxis } = btn.dataset;

      /* 1. Clear modal content */
      modalBody.innerHTML = '';

      /* 2. Inject new content with proper structure */
      modalBody.innerHTML = `
        <img src="${productImage}" alt="${productTitle}">
        <div>
          <div>
            <h2>${productTitle}</h2>
            <div class="price">${formatMoney(productPrice)}</div>
          </div>
          <div class="actions">
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="${productId}">
              <button type="submit">Add to cart</button>
            </form>
            <a href="${productUrl}">View product</a>
          </div>
        </div>
      `;

      /* 3. Show modal */
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');

      positionTheModal(xAxis, yAxis, modal)
    });
  });

  /* Close button */
  modalCloseBtn.addEventListener('click', () => {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    modalBody.innerHTML = '';
  });

  /* ---------------- Helpers ---------------- */

  function formatMoney(cents) {
    if (!cents) return '';
    return `₹${Number(cents).toFixed(2)}`;
  }

  function positionTheModal (x, y, target){
    console.log("Target is =>", target);
    target.style.width = "300px"
    
    
    if(x < 50 && y < 50 ) {
      // TOP - LEFT
      console.log("TOP - LEFT");
      target.style.top = "50px"
      target.style.left = "20px"
      
    } else if (x < 50 && y > 50) {
      // BOTTOM - LEFT
      console.log("BOTTOM - LEFT");
      target.style.bottom = "50px"
      target.style.left = "20px"
    } else if (x > 50 && y < 50) {
      // TOP - RIGHT
      console.log("TOP - RIGHT");
      target.style.top = "50px"
      target.style.right = "20px"
    } else {
      // BOTTOM - RIGHT
      console.log("BOTTOM - RIGHT");
      target.style.bottom = "50px"
      target.style.right = "20px"
    }
  }
</script>

{% schema %}
{
  "name": "Hotspot section",
  "tag": "section",
  "class": "hotspot-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hotspot_section_image",
      "label": "Add image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "range",
          "id": "x_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 10,
          "label": "X-axis position"
        },
        {
          "type": "range",
          "id": "y_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 10,
          "label": "Y-axis position"
        },
        {
          "type": "product",
          "id": "hotspot_product",
          "label": "Link Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hotspot Section TEST"
    }
  ]
}
{% endschema %}