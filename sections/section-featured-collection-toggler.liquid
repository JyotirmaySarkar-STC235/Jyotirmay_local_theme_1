<div class="home__featured-collection-togger-wrapper">
    <div class="home__featured-collection-togger-container">
        {% comment %} Options {% endcomment %}
        <div class="home__featured-collection-togger-options-container">
            <button class="option-btn">{{ section.settings.toggle_collection_1.title }}</button>
            <button class="option-btn active-option">{{ section.settings.toggle_collection_2.title }}</button>
        </div>

        {% comment %} Cards {% endcomment %}
    </div>

</div>

<style>
    .home__featured-collection-togger {
        box-sizing: border-box;
        width: 100%;
        min-height: 400px;
    }

    .home__featured-collection-togger-wrapper {
        width: 100%;
        min-height: 400px;
        padding: 2rem;
        background-image: url("{{ section.settings.toggle_collection_bg_img | image_url }}");
        background-position: top left;
        background-size: cover;
        background-repeat: no-repeat; 
        display: flex;
        align-items: flex-start;
        flex-direction: row-reverse;
    }

    .home__featured-collection-togger-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: center;
        align-items: center;
    }

    .home__featured-collection-togger-options-container {
        background-color: #F7841D;
        color: #FFFFFF;
        width: 383px;
        height: 93px;
        border-radius: 1rem;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;

    }

    .option-btn{
        border: none;
        outline: none;
        background-color: transparent;
        color: #FFFFFF;
        font-size: 1.5rem;
        font-weight: 500;

    }

    .active-option {
        background-color: #FFFFFF;
        color:  #F7841D;
        padding: 1rem 1.5rem;
        border-radius: 10px;
    }




</style>

{% schema %}
    {
        "name": "Collection toggler",
        "tag": "section",
        "class": "home__featured-collection-togger",
        "settings": [
            {
                "type": "image_picker",
                "id": "toggle_collection_bg_img",
                "label": "Select image"
            },
            {
                "type": "collection",
                "id": "toggle_collection_1",
                "label": "Select a collection"
            },
            {
                "type": "collection",
                "id": "toggle_collection_2",
                "label": "Select a collection"
            },
            {
                "type": "color_scheme",
                "id": "toggle_collection_color_scheme",
                "label": "Select color scheme"
            }

        ],
        "presets": [
            {
                "name": "Collection toggler"
            }
        ]
    }
{% endschema %}