{{ 'section-custom-banner.css' | asset_url | stylesheet_tag }}

{% comment %} Added liquid comment for module 2 day 4 task {% endcomment %}

<div class="custom-banner-wrapper color-{{ section.settings.color_scheme }}">
  <div class="text-content-wrapper">
    {% if section.settings.heading != blank %}
      <h3>{{ section.settings.heading }}</h3>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <h4>{{ section.settings.subheading }}</h4>
    {% endif %}

    {% if section.settings.content_text != blank %}
      <p>{{ section.settings.content_text }}</p>
    {% endif %}
  </div>
{{ template.name }}
  <div class="custombanner__buttons-wrapper">
    {% for block in section.blocks %}
      <a href="{{ block.settings.button_link }}">{{ block.settings.button_text }}</a>
    {% endfor %}
  </div>
</div>

<style>
  .custom-banner-wrapper {
    /* BACKGROUND IMAGE OR GRADIENT */
    {% if section.settings.bgimage != blank %}
      background-image: url({{ section.settings.bgimage | image_url: width: 1600 }});
      background-size: cover;
      background-position: center;
    {% else %}
      background: linear-gradient(135deg, #87CEEB, #00FFCC);
    {% endif %}

    /* LAYOUT */
    justify-content: {{ section.settings.vertical_alignment }};
    align-items: {{ section.settings.horizontal_alignment }};
  }
</style>



{% schema %}
{
  "name": "Custom banner",
  "tag": "section",
  "class": "container",
  "limit": 1,
  "settings": [
    {
      "type": "image_picker",
      "id": "bgimage",
      "label": "Select image for background"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Add your heading here."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub heading",
      "default": "Add your subheading heading here."
    },
    {
      "type": "textarea",
      "id": "content_text",
      "label": "Enter text content here",
      "default": "Lorem ipsum dollar go. Lorem ipsum dollar go. Lorem ipsum dollar go. Lorem ipsum dollar go. Lorem ipsum dollar go."
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "button",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Heading",
          "default": "Hello, world!"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Add link to button"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom banner"
    }
  ]
}
{% endschema %}
