<section class="color-{{ section.settings.color_scheme }}">
  <div class="featured-collection">
    
    <h2 class="featured-collection__heading">
      {{ section.settings.section_heading }}
    </h2>

    <div class="featured-collection__list">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}

        {% if collection %}
          <div class="featured-collection__card 
            {% if forloop.first %} featured-collection__card--first 
            {% elsif forloop.last %} featured-collection__card--last 
            {% endif %}
          ">

            {% if collection.featured_image %}
              {{ collection.featured_image 
                | image_url: width: 323, height: 400 
                | image_tag: class: 'featured-collection__image'
              }}
            {% endif %}

            <p class="featured-collection__title">{{ collection.title }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>



<style>
  .section-home-featured-collection {
    display: flex;
    justify-content: center; 
    box-sizing: border-box;
    overflow: hidden; 
  }

  .featured-collection {
    max-width: 1200px;
    width: 100%;
    padding: 40px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  .featured-collection__heading {
    font-size: 28px;
    font-weight: 600;
    text-align: center;
  }

  .featured-collection__list {
    display: flex;
    flex-wrap: wrap; 
    justify-content: center;
    gap: 20px; 
    padding: 1rem;
  }

  /* CARD */
  .featured-collection__card {
    width: 270px;
    height: auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
    align-items: center;
  }

  /* IMAGE */
  .featured-collection__image {
    width: 100%;
    height: 360px; 
    object-fit: cover;
    display: block;
    border-radius: 8px; 
  }

  /* modifiers */
  .featured-collection__card--first .featured-collection__image {
    border-top-left-radius: 60px;
  }

  .featured-collection__card--last .featured-collection__image {
    border-bottom-right-radius: 60px;
  }

  .featured-collection__title {
    font-size: 18px;
    font-weight: 400;
    text-align: center;
  }

  /* MEDIA QUERIES..... */
  @media (max-width: 768px) {
    .featured-collection__card {
      width: 45%;
    }

    .featured-collection__image {
      height: 260px;
    }
  }

  @media (max-width: 480px) {
    .featured-collection__card {
      width: 100%;
    }

    .featured-collection__image {
      height: 220px;
    }
  }
</style>


{% schema %}
  {
  "name": "Home Featured Collection",
  "class": "section-home-featured-collection",
  "tag": "section",
  "max_blocks": 4,

  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "Featured Collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Select color scheme",
    }
  ],

  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select a collection"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Home Page Featured Collection"
    }
  ]
}

{% endschema %}
