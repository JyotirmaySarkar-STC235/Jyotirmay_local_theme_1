<div class="home__conditional-collection-wrapper">
  {% comment %} row for buttons {% endcomment %}
  <div class="home__conditional-collection-row-1">
    <div class="home__conditional-collection-options-container">
      <button id="toggle-option-btn-1" class="option-btn active-option">
        {{ section.settings.toggle_collection_1.title }}
      </button>

      <button id="toggle-option-btn-2" class="option-btn">
        {{ section.settings.toggle_collection_2.title }}
      </button>
    </div>
  </div>

  {% comment %} rows for cards sliders {% endcomment %}
  <div id="conditional-row-2-{{ section.id }}" class="home__conditional-collection-row-2 mySwiper">
    <div class="home__conditional-collection-row-2 swiper-wrapper">
      {% for product in section.settings.toggle_collection_1.products %}
        <div class="conditional-product-card swiper-slide">
          {% comment %} card content {% endcomment %}
          <a href="{{ product.url }}" class="conditional-product-card__image-wrapper">
            {% if product.featured_image != blank %}
              {{
                product.featured_image
                | image_url: width: 400
                | image_tag: alt: 'Product Image', class: 'conditional-product-card__image'
              }}
            {% endif %}
          </a>

          <h3 class="conditional-product-card__title">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>

          <p class="conditional-product-card__price">
            {{ product.price | money }}
          </p>

          <form method="post" action="/cart/add">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="conditional-product-card__button">Add to Cart</button>
          </form>
        </div>
      {% endfor %}
    </div>
  </div>

  <div id="conditional-row-3" class="home__conditional-collection-row-3 hidden">
    {% comment %} section 2 collection>product cards {% endcomment %}
  </div>
</div>

<style>
      .home__conditional-collection {
          min-height: 400px;
          width: 100%;
          background-image: url("{{ section.settings.toggle_collection_bg_img | image_url }}");
          background-size: cover;
          padding: 2rem;
      }

      .home__conditional-collection-wrapper {
          width: 100%;
          display: flex;
          flex-direction: column;
          gap: 2rem;
          /* align-items: center; */
      }

      .home__conditional-collection-row-1 {
        display: flex;
        flex-direction: row-reverse;
    }

      .home__conditional-collection-options-container {
          background-color: #F7841D;
          color: #FFFFFF;
          width: 280px;
          height: 80px;
          border-radius: 1rem;
          display: flex;
          justify-content: center;
          align-items: center;
          gap: 1rem;

      }

      .option-btn{
          border: none;
          outline: none;
          background-color: transparent;
          color: #FFFFFF;
          font-size: 1.8rem;
          font-weight: 500;
          cursor: pointer;
      }

      .active-option {
          background-color: #FFFFFF;
          color:  #F7841D;
          padding: 1rem 1.5rem;
          border-radius: 10px;
      }

      .home__conditional-collection-row-2 {
          width: 100%;
      }

      .hidden {
          display: none;
      }

      /* PRODUCT CARD gpt */
    .conditional-product-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;            /* Swiper handles actual width */
        padding: 15px;
        border-radius: 12px;
        background: #fff;
        gap: 10px;
        text-align: center;
  }

  .conditional-product-card__image-wrapper {
        width: 100%;
        display: block;
  }

  .conditional-product-card__image {
        width: 100%;
        height: auto;
        border-radius: 12px;
  }

  .conditional-product-card__title {
        font-size: 16px;
        font-weight: 600;
        margin: 0;
  }

  .conditional-product-card__price {
        font-size: 14px;
        margin: 0;
  }

  .conditional-product-card__button {
        padding: 10px 18px;
        border: none;
        background: #000;
        color: #fff;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
  }
</style>

{% comment %} Button active class toggler script {% endcomment %}
<script>
  let buttons = document.getElementsByClassName('option-btn');
  let button1 = document.getElementById('toggle-option-btn-1');
  let button2 = document.getElementById('toggle-option-btn-2');

  let collection1 = document.getElementById('toggler-card-list-1');
  let collection2 = document.getElementById('toggler-card-list-2');

  for (let i = 0; i < buttons.length; i++) {
    let button = buttons[i];

    button.addEventListener('click', () => {
      // Remove active class from both buttons
      button1.classList.remove('active-option');
      button2.classList.remove('active-option');

      // Add active class to clicked one
      button.classList.add('active-option');
    });
  }
</script>

<!-- Initialize Swiper -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    var swiper = new Swiper('#conditional-row-2-{{ section.id }}', {
      slidesPerView: 3,
      spaceBetween: 10,
      centeredSlides: true,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
    });
  });
</script>

{% schema %}
{
  "name": "Collection toggler",
  "tag": "section",
  "class": "home__conditional-collection",
  "settings": [
    {
      "type": "image_picker",
      "id": "toggle_collection_bg_img",
      "label": "Select image"
    },
    {
      "type": "collection",
      "id": "toggle_collection_1",
      "label": "Select a collection"
    },
    {
      "type": "collection",
      "id": "toggle_collection_2",
      "label": "Select a collection"
    },
    {
      "type": "color_scheme",
      "id": "toggle_collection_color_scheme",
      "label": "Select color scheme"
    }
  ],
  "presets": [
    {
      "name": "Conditional collections"
    }
  ]
}
{% endschema %}
